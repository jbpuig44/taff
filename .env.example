# Taff - Configuration
# Copiez ce fichier vers .env et remplissez vos identifiants

# APEC (api.apec.fr)
TAFF_APEC_EMAIL=
TAFF_APEC_PASSWORD=

# Indeed (fr.indeed.com)
TAFF_INDEED_EMAIL=
TAFF_INDEED_PASSWORD=

# Cadremploi (cadremploi.fr)
TAFF_CADREMPLOI_EMAIL=
TAFF_CADREMPLOI_PASSWORD=

# Playwright (navigateur headless)
# Mettre à false pour voir le navigateur (debug)
TAFF_BROWSER_HEADLESS=true
# Ralentir les actions (ms, utile pour debug)
TAFF_BROWSER_SLOW_MO=0
